# Vercel AI Gateway (local development only; Vercel deploys use OIDC)
AI_GATEWAY_API_KEY=

# Clerk identity and Google OAuth broker
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Postgres
DATABASE_URL=

# Optional Gmail push notifications. Creating the Pub/Sub topic is an external setup step.
GMAIL_PUBSUB_TOPIC=

# Public canonical origin used in metadata and OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
